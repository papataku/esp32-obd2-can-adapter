// Production GATT functions + real Session and CanOwner; only BLE/TWAI IO stubbed.
#include "signal_v2_can_owner.h"
#include "signal_v2_session.h"
#include "demo_touch_control.h"
#include <atomic>
#include <cassert>
#include <cstring>
#include <iostream>
using namespace signal_v2;
SerialStub Serial;
uint32_t g_test_millis=0;
static unsigned tx=0;
static m5can::CanStats health{};
namespace m5can {
CanStats CanMonitor::stats() const {return health;}
void CanMonitor::revokeLease() {}
bool CanMonitor::acquireLease(uint32_t) {return true;}
bool CanMonitor::submitQuery(const DiagnosticRequest&) {++tx;return true;}
bool CanMonitor::pollQueryResult(DiagnosticResult&) {return false;}
void CanMonitor::endObservationAudit(ObservationAudit& a,CanStats& s){a=audit_;s=stats_;}
}
CanOwner owner;
struct Link {
  uint16_t handle=7;
  uint32_t generation=1;
  bool active=false,status=true,data=true,registered=true,encrypted=true,bonded=true;
} links[2];
portMUX_TYPE mux;
Link snapshot(unsigned i){return links[i];}
bool authorized(const Link& l){return l.registered&&l.encrypted&&l.bonded;}
struct Peer {uint32_t generation=1;Session session;Packet output;size_t dataoff=0;} peers[2];
std::atomic<bool> can_armed{false}, manual_stop{false},manual_stop_pending{false};
std::atomic<uint32_t> can_authorization_epoch{1};
uint32_t armed_until=0;
struct AutoArmSession {
  bool tracking=false;unsigned slot=0;
  uint32_t generation=0,session=0,epoch=0,since=0;
} auto_session;
@GRANT@
void manage(const char* cmd,uint32_t now){
@STOP@
@ARM@
}
@DISCONNECT@
@AUTO@
void pollAuthorization(uint32_t now) {
  serviceAutoArm(now);
@TTL@
}
namespace signal_v2 {void manualCanStop(){::manualCanStop();}}
struct FakeTouchDetail {
  int x=1,y=1;
  bool wasPressed()const{return true;}
};
struct FakeDial {
  void update(){}
  struct TouchInput {FakeTouchDetail getDetail()const{return {};}} Touch;
} M5Dial;
namespace m5can {
class Ui {
public:
  bool pollDemoToggle();
  bool show_ble_peer_page_=false;
  DemoTouchControl demo_touch_;
};
@TOUCH@
}
static uint32_t rid=0;
static Packet command(uint8_t op,const uint8_t* body=nullptr,size_t n=0) {
  uint8_t b[200]{};w32(b,++rid);w32(b+4,peers[0].session.revision());
  b[8]=op;w16(b+10,n);if(n)std::memcpy(b+12,body,n);
  return encode(1,op==1?0:17,op==1?0:peers[0].session.id(),rid,b,n+12);
}
static void control(uint8_t op,uint32_t now,const uint8_t* b=nullptr,size_t n=0){
  Packet ack;peers[0].session.control(command(op,b,n),true,now,ack);
  assert(ack.size&&ack.payload()[5]==Accept);
}
static void connectSession(uint32_t sid,uint32_t now) {
  links[0].active=links[0].status=links[0].data=true;++links[0].generation;
  peers[0].generation=links[0].generation;peers[0].session.connect(17,sid);
  uint8_t h[12]{1,2};w16(h+4,512);control(1,now,h,12);
  assert(!peers[0].session.active(now)); // HELLO alone is insufficient
  serviceAutoArm(now);assert(!can_armed);
  uint8_t p[8+24*5]{};w32(p,1);p[4]=5;
  for(unsigned i=0;i<5;++i){auto e=p+8+24*i;w16(e,i+1);e[2]=1;
    w16(e+4,CanSamples::Pids[i]);e[6]=i==0?0:1;w32(e+12,1);
    w16(e+16,200);w16(e+18,400);w16(e+20,600);}
  control(2,now,p,sizeof(p));assert(peers[0].session.active(now));
}
int main() {
  m5can::CanMonitor monitor;owner.attach(&monitor);
  owner.tick(0,{},false,1);
  assert(!can_armed&&tx==0); // boot cannot grant or submit
  connectSession(19,100);
  for(unsigned missing=0;missing<3;++missing){
    links[0].registered=links[0].encrypted=links[0].bonded=true;
    if(missing==0)links[0].registered=false;
    if(missing==1)links[0].encrypted=false;
    if(missing==2)links[0].bonded=false;
    serviceAutoArm(100);serviceAutoArm(2100);assert(!can_armed);
  }
  links[0].registered=links[0].encrypted=links[0].bonded=true;
  serviceAutoArm(2100);control(4,3000);serviceAutoArm(4099);assert(!can_armed);
  serviceAutoArm(4100);assert(can_armed&&can_authorization_epoch==2);
  const auto first_epoch=can_authorization_epoch.load();
  // KeepAlive-backed session authorization survives >600000ms; no CAN model tick
  // here because an intentionally absent ECU would correctly fault discovery.
  for(uint32_t now=5000;now<610000;now+=1000){
    control(4,now);pollAuthorization(now);
    assert(can_armed&&int32_t(armed_until-now)>0);
    assert(can_authorization_epoch==first_epoch);
  }
  disconnected(7);assert(!can_armed);
  owner.tick(610000,{},false,can_authorization_epoch.load());
  const auto old_generation=owner.samples().source_generation;
  serviceAutoArm(610000);
  connectSession(20,610001);serviceAutoArm(610001);
  control(4,612000);serviceAutoArm(612000);assert(!can_armed);
  serviceAutoArm(612001);assert(can_armed&&can_authorization_epoch>first_epoch);
  owner.tick(612001,{},true,can_authorization_epoch.load());
  assert(owner.samples().source_generation>old_generation);
  for(const auto& v:owner.samples().values)assert(v.quality>1);
  // Exact 3s expiry stops without a disconnect; a new profile must settle again.
  serviceAutoArm(615000);assert(!can_armed);
  owner.tick(615000,{},false,can_authorization_epoch.load());
  connectSession(21,616000);serviceAutoArm(616000);
  control(4,618000);serviceAutoArm(618000);assert(can_armed);
  // Session END, even on the same physical connection, invalidates the grant.
  control(10,618001);serviceAutoArm(618001);assert(!can_armed);
  connectSession(22,619000);serviceAutoArm(619000);
  control(4,621000);serviceAutoArm(621000);assert(can_armed);
  m5can::Ui ui;assert(!ui.pollDemoToggle());assert(!can_armed&&manual_stop&&manual_stop_pending);
  owner.tick(621001,{},false,can_authorization_epoch.load());
  control(4,623000);serviceAutoArm(623000);assert(!can_armed);
  manage("SIGV2 CAN ARM",623000);assert(can_armed&&!manual_stop);
  serviceAutoArm(623000);assert(can_armed); // USB rearm binds without self-revoking
  manage("SIGV2 CAN STOP",623001);assert(manual_stop&&!can_armed);
  control(4,625000);serviceAutoArm(625000);assert(!can_armed);
  manage("SIGV2 CAN ARM",625000);assert(can_armed);
  health.driver_bus_error=1;
  owner.tick(625000,{},true,can_authorization_epoch.load());
  assert(owner.stopReason()&&owner.stopped());
  can_armed=false;++can_authorization_epoch;
  health={}; // recovery cannot clear a boot-latched fault
  manage("SIGV2 CAN ARM",625001);assert(!can_armed);
  serviceAutoArm(625002);serviceAutoArm(627002);assert(!can_armed);
  owner.tick(627003,{},true,++can_authorization_epoch);
  assert(owner.stopped()&&owner.stopReason());
  CanOwner rebooted;assert(!rebooted.stopReason());
  assert(tx==0);
  std::cout<<"PASS secured settle, active TTL, reconnect/new epoch/Invalid, lease/end, tap/USB STOP, fault latch/reboot\n";
}
